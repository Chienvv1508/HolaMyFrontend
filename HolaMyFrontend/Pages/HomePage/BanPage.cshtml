@page
@model HolaMyFrontend.Pages.HomePage.BanPageModel
@{
}
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông báo tài khoản bị cấm</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #ff4d4d, #ff8e53);
            overflow: hidden;
        }

        .container_ban {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            box-sizing: border-box;
        }

        .message {
            font-family: Arial, sans-serif;
            font-weight: bold;
            font-size: 48px;
            color: #fff;
            text-align: center;
            background: rgba(255, 255, 255, 0.1);
            padding: 30px 50px;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            max-width: 90%;
            word-wrap: break-word;
        }

    </style>
</head>
<body>
    <div class="container_ban">
        <div class="message">Tài khoản của bạn đã bị cấm.</div>
    </div>
</body>
</html>